# One-tap demo login (src/lib/hyrja-demo.ts). Leave empty here; scripts/demo-env.ps1 fills .env.local from .env.demo.
# EXPO_PUBLIC_* goes into the app bundle; only for demo accounts, never in an EAS/APK build profile.
# A role's button shows only when QUICK_LOGIN is "true" and both its email and password are set.
EXPO_PUBLIC_QUICK_LOGIN=
EXPO_PUBLIC_DEMO_KERKUES_EMAIL=
EXPO_PUBLIC_DEMO_KERKUES_PASSWORD=
EXPO_PUBLIC_DEMO_PUNEDHENES_EMAIL=
EXPO_PUBLIC_DEMO_PUNEDHENES_PASSWORD=
EXPO_PUBLIC_DEMO_QENDER_EMAIL=
EXPO_PUBLIC_DEMO_QENDER_PASSWORD=
